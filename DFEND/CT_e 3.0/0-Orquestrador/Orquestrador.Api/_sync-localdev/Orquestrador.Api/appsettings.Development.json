{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "System.Net.Http.HttpClient.MonitorClient.LogicalHandler": "Warning",
      "System.Net.Http.HttpClient.MonitorClient.ClientHandler": "Warning"
