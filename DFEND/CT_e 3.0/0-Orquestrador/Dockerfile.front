# Frontend Orquestrador CT-e (Nx Angular → nginx)
# Build em Debian (não Alpine): npm/Nx mais estável em rede corporativa.
FROM node:20-bookworm-slim AS build
WORKDIR /app

# Retries — útil com proxy/rede instável
RUN npm config set fetch-retries 5 \
 && npm config set fetch-retry-mintimeout 20000 \
 && npm config set fetch-retry-maxtimeout 120000

COPY Frontend/package.json Frontend/package-lock.json ./
# npm ci é estrito; se falhar (lock/rede), cai para npm install
RUN npm ci --no-audit --no-fund \
 || (echo "[WARN] npm ci falhou — tentando npm install..." && npm install --no-audit --no-fund)

COPY Frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine AS final
COPY docker/nginx-front.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/apps/cte-orquestrador/browser /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
