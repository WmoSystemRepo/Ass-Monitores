{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    "ConnectionString": "",
    "ConnectionStringSintetico": "",
    "CodServicoArquivador": 3,
    "WindowsServiceName": "DFEND_CTe_Arquivador",
    "ServiceId": "dfend-cte-monitor-arquivador",
    "DisplayName": "Monitor Arquivador CT-e",
    "Domain": "arquivador",
    "ApiVersion": "1.0",
    "MonitoredService": "DFEND_CTe_Arquivador",
    "InternalApiKey": "",
    "ArquivadorRootPath": "",
    "ArquivadorExeRelativePath": "tools\\Arquivador.DevHost\\bin\\Debug\\Arquivador.DevHost.exe",
    "ArquivadorProcessName": "Arquivador.DevHost",
    "PreferLocalProcess": true,
    "SqlTimeoutSeconds": 3,
    "SnapshotIntervalMs": 2000,
    "LogsIntervalMs": 1000,
    "ConfigCacheSeconds": 30,
    "RecentDocumentsTake": 50,
    "RecentLogsTake": 100
  },
  "AlertThresholds": {
    "FilaAlta": 100,
    "FilaCrescendoMinDepth": 20,
    "FilaCrescendoSnapshots": 3,
    "TmpErroWindowSize": 50,
    "StaleMinutesFloor": 5,
    "StaleIntervalMultiplier": 3
  }
}
