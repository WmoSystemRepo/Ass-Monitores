{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    "ConnectionString": "",
    "ConnectionStringSintetico": "",
    "CodServicoIntegrador": 7,
    "WindowsServiceName": "DFEND_CTe_Integrador",
    "ServiceId": "dfend-cte-monitor-integrador",
    "DisplayName": "Monitor Integrador CT-e",
