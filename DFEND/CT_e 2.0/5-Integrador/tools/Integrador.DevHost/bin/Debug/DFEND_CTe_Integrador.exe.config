<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
			<section name="DFEND_CTe_Integrador.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
		</sectionGroup>
	</configSections>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7" />
	</startup>
	<appSettings>
		<!-- Comuns -->
		<add key="NomeServico" value="DFEND_CTe_Integrador" />
		<add key="CodServicoIntegrador" value="7" />
		<!-- Bancos CT-e (desenvolvimento: Windows Auth em texto claro) -->
		<add key="BDCTeSintetico" value="Data Source=DDFESIN\BDD_DFE_SINTETIC;Initial Catalog=bd_cte_sintetico;Integrated Security=SSPI;Connect Timeout=60" />
		<add key="BDCTeAnalitico" value="Data Source=DDFEANA\BDD_DFE_ANALITIC;Initial Catalog=bd_cte_analitico;Integrated Security=SSPI;Connect Timeout=60" />
		<add key="BDNFeDefinitivo" value="Data Source=dnfen\bdd_nfen;Initial Catalog=bd_nfen;Integrated Security=SSPI;Connect Timeout=60" />
		<add key="BDStaging" value="Data Source=DDFE\BDD_DFE;Initial Catalog=bd_staging;Integrated Security=SSPI;Connect Timeout=60" />
	</appSettings>
	<applicationSettings>
	</applicationSettings>
</configuration>
