{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    "ConnectionString": "",
    "CodServicoReceptor": 2,
    "WindowsServiceName": "DFEND_CTe_Receptor",
    "ServiceId": "dfend-cte-monitor-receptor",
    "DisplayName": "Monitor Receptor CT-e",
    "Domain": "receptor",
    "ApiVersion": "1.0",
    "MonitoredService": "DFEND_CTe_Receptor",
    "InternalApiKey": "",
    "ReceptorRootPath": "",
    "ReceptorExeRelativePath": "tools\\Receptor.DevHost\\bin\\Debug\\Receptor.DevHost.exe",
    "ReceptorProcessName": "Receptor.DevHost",
    "PreferLocalProcess": true,
    "SqlTimeoutSeconds": 3,
    "SnapshotIntervalMs": 2000,
    "LogsIntervalMs": 1000,
    "ConfigCacheSeconds": 30,
    "RecentDocumentsTake": 50,
    "RecentLogsTake": 100
  },
  "AlertThresholds": {
    "FilaAlta": 100,
    "FilaCrescendoMinDepth": 20,
    "FilaCrescendoSnapshots": 3,
    "TmpErroWindowSize": 50,
    "StaleMinutesFloor": 5,
    "StaleIntervalMultiplier": 3
  }
}
