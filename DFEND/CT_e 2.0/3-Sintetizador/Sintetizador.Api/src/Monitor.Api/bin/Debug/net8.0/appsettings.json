{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    "ConnectionString": "",
    "ConnectionStringSintetico": "",
    "CodServicoSintetizador": 8,
    "WindowsServiceName": "DFEND_CTe_Sintetizador",
    "ServiceId": "dfend-cte-monitor-sintetizador",
