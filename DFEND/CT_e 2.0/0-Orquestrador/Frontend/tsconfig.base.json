{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@orquestrador/monitor-config": ["libs/monitor-config/src/index.ts"],
      "@orquestrador/monitor-core": ["libs/monitor-core/src/index.ts"],
      "@orquestrador/monitor-dashboard": [
        "libs/monitor-dashboard/src/index.ts"
      ],
      "@orquestrador/monitor-logs": ["libs/monitor-logs/src/index.ts"],
      "@orquestrador/monitor-tables": ["libs/monitor-tables/src/index.ts"],
      "@orquestrador/monitor-threads": ["libs/monitor-threads/src/index.ts"],
      "@orquestrador/resgate-cte": ["libs/resgate-cte/src/index.ts"],
      "@orquestrador/shared-data": ["libs/shared-data/src/index.ts"],
      "@orquestrador/shared-ui": ["libs/shared-ui/src/index.ts"],
      "@orquestrador/shared-utils": ["libs/shared-utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
