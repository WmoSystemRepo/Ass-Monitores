{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    "ConnectionString": "",
    "ConnectionStringAnalitico": "",
    "CodServicoAnalisador": 6,
    "WindowsServiceName": "DFEND_CTe_Analisador",
    "ServiceId": "dfend-cte-monitor-analisador",
    "DisplayName": "Monitor Analisador CT-e",
    "Domain": "analisador",
    "ApiVersion": "1.0",
